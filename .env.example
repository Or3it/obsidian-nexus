# Copy to .env (gitignored) and fill in. The orchestrator reads these from the
# process environment, so export them in your shell or add them to your
# LaunchAgent plist's EnvironmentVariables block — .env is not auto-loaded.

# Rung: Google Gemini via AI Studio — https://aistudio.google.com/apikey
GOOGLE_AI_STUDIO_API_KEY=your-google-ai-studio-key

# Rung: OpenRouter free/paid pool — https://openrouter.ai/keys
OPENROUTER_API_KEY=your-openrouter-key

# Optional: only needed when enable_web_tools=True (Anthropic SDK path).
# Rung 1 normally uses the locally authenticated Claude Code CLI instead.
ANTHROPIC_API_KEY=
